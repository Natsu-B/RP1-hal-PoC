# Standard drivers only. Resolve against the selected Raspberry Pi Linux Kconfig.
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_MFD_RP1=y
CONFIG_COMMON_CLK=y
# CONFIG_COMMON_CLK_RP1 is not set
CONFIG_MAILBOX=y
CONFIG_MBOX_RP1=y
CONFIG_ARM_SCMI_PROTOCOL=y
CONFIG_ARM_SCMI_TRANSPORT_MAILBOX=y
CONFIG_COMMON_CLK_SCMI=y
CONFIG_RESET_CONTROLLER=y
CONFIG_RESET_SCMI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_REMOTEPROC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_RPMSG_CHAR=y
CONFIG_RPMSG_CTRL=y
# These symbols do NOT create RP1 remoteproc/virtio hardware or an attach driver.
