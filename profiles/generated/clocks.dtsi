/* Generated policy definitions; transport placement is separate. */
/ {
    rp1_clock_profile {
        profile-sha256 = "48b58f49fb47dace18a22d24a40a6b1f9853df023f2233e7e23355741a7c67d4";
    };
    rp1_fixed_uart: rp1-fixed-uart {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <50000000>;
        clock-output-names = "rp1-profile-uart";
    };
    rp1_fixed_mipi0_cfg: rp1-fixed-mipi0-cfg {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <25000000>;
        clock-output-names = "rp1-profile-mipi0_cfg";
    };
    rp1_fixed_mipi1_cfg: rp1-fixed-mipi1-cfg {
        compatible = "fixed-clock";
        #clock-cells = <0>;
        clock-frequency = <25000000>;
        clock-output-names = "rp1-profile-mipi1_cfg";
    };
};
&rp1_scmi {
    rp1_scmi_clocks: protocol@14 {
        reg = <0x14>;
        #clock-cells = <1>;
    };
};
